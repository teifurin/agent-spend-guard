{
  "name": "agent-spend-guard",
  "version": "0.0.1",
  "private": true,
  "description": "Policy and human-approval guardrail between AI agents and PayPal (sandbox only). PayPal AI Hackathon 2026 entry.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "check-env": "tsx scripts/check-env.ts",
    "spike:vault": "tsx scripts/spike-vault.ts --mode vault",
    "spike:order": "tsx scripts/spike-vault.ts --mode order",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/server/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "demo:agent": "tsx scripts/demo-agent.ts",
    "demo:seed": "tsx scripts/demo-seed.ts",
    "link-paypal": "tsx scripts/link-paypal.ts",
    "e2e:sandbox": "tsx scripts/e2e-sandbox.ts",
    "e2e:offline": "tsx scripts/e2e-sandbox.ts --offline"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.90",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ai": "^7.0.155",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  }
}
