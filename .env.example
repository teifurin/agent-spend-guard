# Copy this file to .env and fill in the values. NEVER commit .env (it is gitignored).
# This file holds variable NAMES only. No real value belongs here.

# PayPal REST app credentials: https://developer.paypal.com/dashboard/applications/sandbox
# The sandbox app needs the vault permission before its keys are used: tick "Save payment methods" under Payment
# capabilities (older dashboards: Advanced options -> Vault) and save.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be exactly SANDBOX. The code refuses to start with any other value and never calls live PayPal.
PAYPAL_ENV=SANDBOX

# The AI risk reviewer (M3). "mock" = deterministic rules, no key, the default; judges can run everything with it.
# "anthropic" = Claude through the Vercel AI SDK; then LLM_API_KEY is required and the server refuses to start without it.
LLM_PROVIDER=mock
LLM_API_KEY=
# Model id for LLM_PROVIDER=anthropic. Default: claude-opus-5-5
LLM_MODEL=
# How long one review may take before the request is held for the owner instead. Defaults: 8000 (mock), 30000 (anthropic).
# REVIEW_TIMEOUT_MS=30000
# Extra origins (scheme://host:port, comma-separated) the reviewer may fetch product pages from. The shop's origin is always allowed.
# REVIEW_PAGE_ORIGINS=

# Where the owner dashboard is reachable (LAN IP or tunnel when testing on a phone). Used from M2.
PUBLIC_BASE_URL=http://localhost:3000

# Spike script (M0): local port that receives PayPal's return/cancel redirect.
SPIKE_PORT=8787
# If PayPal rejects an http://127.0.0.1 return URL, set a dummy https base and rely on Enter / status polling.
# SPIKE_RETURN_BASE=https://example.com

# SQLite database file used by the guard, the dashboard and the sandbox end-to-end run (from M1).
# Gitignored together with its -wal/-shm companions. Default: data/guard.db
DB_PATH=data/guard.db

# Guard server (dashboard, agent API, SSE) and the synthetic shop, which runs on its own origin (from M2).
# Bind address. 127.0.0.1 keeps the login-less dashboard local; set 0.0.0.0 only to show it on a phone on the same Wi-Fi.
HOST=127.0.0.1
PORT=3000
SHOP_PORT=3001
# Where the demo agent finds the shop and the guard API; defaults match the two ports above.
SHOP_URL=http://localhost:3001
GUARD_URL=http://localhost:3000
# Which agent the MCP server speaks for. The demo seed creates "research-bot".
AGENT_ID=research-bot
