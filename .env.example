# Copy this file to .env and fill in the values. NEVER commit .env (it is gitignored).
# This file holds variable NAMES only. No real value belongs here.

# PayPal REST app credentials: https://developer.paypal.com/dashboard/applications/sandbox
# The sandbox app needs "Accept payments" enabled and, under Advanced options, "Vault" ticked.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be exactly SANDBOX. The code refuses to start with any other value and never calls live PayPal.
PAYPAL_ENV=SANDBOX

# LLM used by the shopping agent and the AI risk reviewer (from milestone M3).
# "mock" runs everything with deterministic rules and needs no key, so judges can run the demo keyless.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=

# Where the owner dashboard is reachable (LAN IP or tunnel when testing on a phone). Used from M2.
PUBLIC_BASE_URL=http://localhost:3000

# Spike script (M0): local port that receives PayPal's return/cancel redirect.
SPIKE_PORT=8787
# If PayPal rejects an http://127.0.0.1 return URL, set a dummy https base and rely on Enter / status polling.
# SPIKE_RETURN_BASE=https://example.com

# SQLite database file used by the guard, the dashboard and the sandbox end-to-end run (from M1).
# Gitignored together with its -wal/-shm companions. Default: data/guard.db
DB_PATH=data/guard.db
